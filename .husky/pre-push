# Block direct pushes to main/staging; merge via PR instead.
# First push of a branch (doesn't exist on the remote yet) is allowed.
# Override with: ALLOW_PROTECTED_PUSH=1 git push
[ "$ALLOW_PROTECTED_PUSH" = "1" ] && exit 0

zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/staging)
      if [ "$remote_sha" != "$zero" ]; then
        echo "Direct push to '${remote_ref#refs/heads/}' is blocked. Open a PR, or set ALLOW_PROTECTED_PUSH=1."
        exit 1
      fi
      ;;
  esac
done
exit 0
