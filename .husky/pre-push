# Block direct pushes to main/staging; merge via PR instead.
# Override with: ALLOW_PROTECTED_PUSH=1 git push
branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$ALLOW_PROTECTED_PUSH" != "1" ] && { [ "$branch" = "main" ] || [ "$branch" = "staging" ]; }; then
  echo "Direct push to '$branch' is blocked. Open a PR, or set ALLOW_PROTECTED_PUSH=1."
  exit 1
fi
